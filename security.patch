+  const now = Date.now();
+  const entry = failedLogins.get(key);
+  if (!entry || now - entry.firstAt > LOGIN_WINDOW_MS) {
+    failedLogins.set(key, { count: 1, firstAt: now });
+  } else {
+    entry.count += 1;
+  }
+}
