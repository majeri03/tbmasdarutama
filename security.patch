+}
+
+function isLoginRateLimited(key: string): boolean {
+  const entry = failedLogins.get(key);
+  if (!entry) return false;
+  if (Date.now() - entry.firstAt > LOGIN_WINDOW_MS) {
+    failedLogins.delete(key);
+    return false;
+  }
+  return entry.count >= LOGIN_MAX_FAILED;
+}
+
