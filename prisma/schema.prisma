generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== USER MANAGEMENT ====================
model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  password      String
  role          Role      @default(KASIR)
  phone         String?
  address       String?
  expoPushToken String?   // NEW: Untuk Push Notification
  isActive      Boolean   @default(true)
  // PKG-I (23 Nov 2026, OTP verifikasi email): dicatat saat akun baru
  // berhasil verifikasi email. Akun lama (sudah aktif) tidak punya nilai
  // ini — hanya akun yang dibuat setelah fitur OTP rilis.
  emailVerifiedAt DateTime?
  // FIX (22 Nov 2026): versi token mobile — dinaikkan setiap ganti password /
  // nonaktifkan akun / ganti role / logout, supaya token lama langsung mati.
  // verifyMobileToken menolak token yang tv-nya tidak sama dengan ini.
  tokenVersion  Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // Relations
  sales         Sale[]
  purchases     Purchase[]
  debtPayments  DebtPayment[]
  cashMovements CashMovement[]
  deliveryOrders  DeliveryOrder[]
  stockMovements     StockMovement[] 
  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  waOrdersConfirmed   WaOrder[]
  deviceTokens        DeviceToken[]
  notifications       Notification[]
  deliveryPhotos      DeliveryPhoto[]
  r2Files             R2File[]
  // FIX (22 Nov 2026, rombakan armada): kendaraan yang dikemudikan user ini
  // sebagai sopir utama / pendamping (dipilih SUPER_ADMIN/ADMIN saat mendaftar).
  drivenVehicles   FleetVehicle[] @relation("VehicleDriver")
  coDrivenVehicles FleetVehicle[] @relation("VehicleCoDriver")

  @@index([role, isActive])

  @@map("users")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  KASIR
}

// ==================== MASTER SATUAN ====================
model Unit {
  id          String   @id @default(cuid())
  symbol      String?
  name        String   @unique // Sak, Pcs, Kg, Dus, Kardus, Box, Lusin, Meter
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  productUnits      ProductUnit[]
  saleItemsUnit     SaleItem[]         @relation("SaleItemUnit")
  purchaseItemsUnit PurchaseItem[]     @relation("PurchaseItemUnit")
  deliveryItems   DeliveryItem[]
  @@map("units")
}

// ==================== KATEGORI & SUB-KATEGORI ====================
model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  subCategories SubCategory[]
  products      Product[]
  
  @@map("categories")
}

model SubCategory {
  id          String   @id @default(cuid())
  name        String
  description String?
  categoryId  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  category Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  products Product[]
  
  @@map("sub_categories")
}

// ==================== SUPPLIER ====================
model Supplier {
  id          String   @id @default(cuid())
  code        String   @unique // SUP-001
  name        String
  phone       String?
  email       String?
  address     String?
  city        String?
  province    String?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  purchases      Purchase[]
  supplierDebts  SupplierDebt[]
  products    Product[] 
  @@map("suppliers")
}

// ==================== PRODUK ====================
model Product {
  id            String   @id @default(cuid())
  code          String   @unique // PRD-001
  barcode       String?  @unique
  name          String
  description   String?
  categoryId    String
  subCategoryId String?
  supplierId    String?
  minStock      Int      @default(0)
  currentStock  Int      @default(0)
  isActive      Boolean  @default(true)
  deletedAt DateTime?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  // Relations
  category      Category     @relation(fields: [categoryId], references: [id])
  subCategory   SubCategory? @relation(fields: [subCategoryId], references: [id])
  supplier       Supplier?     @relation(fields: [supplierId], references: [id])
  productUnits  ProductUnit[]
  productImages ProductImage[]
  saleItems     SaleItem[]
  purchaseItems PurchaseItem[]
  stockMovements StockMovement[]
  deliveryItems   DeliveryItem[]

  @@index([categoryId])
  @@index([supplierId])
  @@index([deletedAt])
  @@index([name])
  @@index([code])
  @@index([createdAt])

  @@map("products")
}

// ==================== PRODUK SATUAN & HARGA ====================
model ProductUnit {
  id              String   @id @default(cuid())
  productId       String
  unitId          String
  conversionValue Int      @default(1) // 1 Sak = 50 Kg (value: 50)
  buyPrice        Decimal  @db.Decimal(15, 2)
  sellPrice       Decimal  @db.Decimal(15, 2)
  isPrimary       Boolean  @default(false) // Satuan utama
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Relations
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  unit    Unit    @relation(fields: [unitId], references: [id])
  
  @@unique([productId, unitId])
  @@map("product_units")
}

// ==================== PRODUK GAMBAR ====================
model ProductImage {
  id        String   @id @default(cuid())
  productId String
  imageUrl  String
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  
  // Relations
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  @@index([productId])

  @@map("product_images")
}

// ==================== CUSTOMER ====================
model Customer {
  id          String   @id @default(cuid())
  code        String   @unique // CUST-001
  name        String
  phone       String?
  email       String?
  address     String?
  city        String?
  province    String?
  type        CustomerType @default(UMUM)
  isActive    Boolean  @default(true)
  // PKG-A (23 Nov 2026, perbaikan 7 item #5/#6): poin loyalitas customer.
  // Hanya bertambah dari penjualan lunas non-UMUM (lihat createSale);
  // penyesuaian manual hanya lewat adjustCustomerPoints (SUPER_ADMIN).
  points      Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  sales         Sale[]
  customerDebts CustomerDebt[]
  deliveryOrders  DeliveryOrder[]

  @@index([name])
  @@index([phone])
  @@index([type])

  @@map("customers")
}

enum CustomerType {
  UMUM
  REGULER
  GROSIR
  PROYEK
}

// ==================== PENJUALAN (POS) ====================
model Sale {
  id              String   @id @default(cuid())
  invoiceNumber   String   @unique // INV-20240101-001
  customerId      String?
  cashierId       String
  saleDate        DateTime @default(now())
  totalAmount     Decimal  @db.Decimal(15, 2)
  discount        Decimal  @default(0) @db.Decimal(15, 2)
  tax             Decimal  @default(0) @db.Decimal(15, 2)
  grandTotal      Decimal  @db.Decimal(15, 2)
  paymentMethod   PaymentMethod
  paidAmount      Decimal  @db.Decimal(15, 2)
  changeAmount    Decimal  @default(0) @db.Decimal(15, 2)
  notes           String?
  status          SaleStatus @default(COMPLETED)
  // PKG-A (23 Nov 2026, perbaikan 7 item #5): salesperson yang menangani
  // penjualan ini. Dicatat internal saja — TIDAK PERNAH dicetak di
  // invoice/struk/surat jalan.
  salesmanId      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Relations
  customer      Customer?  @relation(fields: [customerId], references: [id])
  cashier       User       @relation(fields: [cashierId], references: [id])
  salesman      Salesman?  @relation(fields: [salesmanId], references: [id])
  saleItems     SaleItem[]
  customerDebts CustomerDebt[]
  deliveryOrder   DeliveryOrder?

  @@index([invoiceNumber])
  @@index([saleDate])
  @@index([customerId])
  @@index([salesmanId])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([cashierId])

  @@map("sales")
}

model SaleItem {
  id         String   @id @default(cuid())
  saleId     String
  productId  String
  unitId     String
  quantity   Int
  unitPrice  Decimal  @db.Decimal(15, 2)
  discount   Decimal  @default(0) @db.Decimal(15, 2)
  subtotal   Decimal  @db.Decimal(15, 2)
  createdAt  DateTime @default(now())
  
  // Relations
  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
  unit    Unit    @relation("SaleItemUnit", fields: [unitId], references: [id])
  
  @@index([saleId])
  @@index([productId])

  @@map("sale_items")
}

// PKG-A (23 Nov 2026, perbaikan 7 item #5): salesperson toko.
// CRUD penuh + dipilih per transaksi di POS; tercatat internal di Sale,
// TIDAK PERNAH dicetak di invoice/struk/surat jalan.
model Salesman {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  sales     Sale[]

  @@map("salesmen")
}

enum PaymentMethod {
  CASH
  TRANSFER
  CREDIT
  DEBIT_CARD
  QRIS
}

enum SaleStatus {
  PENDING
  COMPLETED
  CANCELLED
  RETURN
}

// ==================== PEMBELIAN (PURCHASE ORDER) ====================
model Purchase {
  id              String   @id @default(cuid())
  poNumber        String   @unique // PO-20240101-001
  supplierId      String
  adminId         String
  purchaseDate    DateTime @default(now())
  totalAmount     Decimal  @db.Decimal(15, 2)
  discount        Decimal  @default(0) @db.Decimal(15, 2)
  tax             Decimal  @default(0) @db.Decimal(15, 2)
  grandTotal      Decimal  @db.Decimal(15, 2)
  paidAmount      Decimal  @default(0) @db.Decimal(15, 2)
  paymentMethod   PaymentMethod?
  notes           String?
  status          PurchaseStatus @default(PENDING)
  receivedDate    DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Relations
  supplier       Supplier       @relation(fields: [supplierId], references: [id])
  admin          User           @relation(fields: [adminId], references: [id])
  purchaseItems  PurchaseItem[]
  supplierDebts  SupplierDebt[]
  
  @@index([supplierId])
  @@index([purchaseDate])

  @@map("purchases")
}

model PurchaseItem {
  id         String   @id @default(cuid())
  purchaseId String
  productId  String
  unitId     String
  quantity   Int
  unitPrice  Decimal  @db.Decimal(15, 2)
  discount   Decimal  @default(0) @db.Decimal(15, 2)
  subtotal   Decimal  @db.Decimal(15, 2)
  createdAt  DateTime @default(now())
  
  // Relations
  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])
  unit     Unit     @relation("PurchaseItemUnit", fields: [unitId], references: [id])
  
  @@index([purchaseId])
  @@index([productId])

  @@map("purchase_items")
}

enum PurchaseStatus {
  PENDING
  RECEIVED
  PARTIAL
  CANCELLED
}

// ==================== UTANG CUSTOMER ====================
model CustomerDebt {
  id              String   @id @default(cuid())
  debtNumber      String   @unique // DEBT-CUST-001
  saleId          String
  customerId      String
  totalDebt       Decimal  @db.Decimal(15, 2)
  paidAmount      Decimal  @default(0) @db.Decimal(15, 2)
  remainingDebt   Decimal  @db.Decimal(15, 2)
  dueDate         DateTime
  status          DebtStatus @default(UNPAID)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Relations
  sale            Sale            @relation(fields: [saleId], references: [id])
  customer        Customer        @relation(fields: [customerId], references: [id])
  debtPayments    DebtPayment[]
  
  @@index([status, dueDate])
  @@index([customerId])
  @@index([createdAt])

  @@map("customer_debts")
}

// ==================== UTANG SUPPLIER ====================
model SupplierDebt {
  id              String   @id @default(cuid())
  debtNumber      String   @unique // DEBT-SUPP-001
  purchaseId      String
  supplierId      String
  totalDebt       Decimal  @db.Decimal(15, 2)
  paidAmount      Decimal  @default(0) @db.Decimal(15, 2)
  remainingDebt   Decimal  @db.Decimal(15, 2)
  dueDate         DateTime
  status          DebtStatus @default(UNPAID)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Relations
  purchase        Purchase        @relation(fields: [purchaseId], references: [id])
  supplier        Supplier        @relation(fields: [supplierId], references: [id])
  debtPayments    DebtPayment[]
  
  @@index([status, dueDate])
  @@index([supplierId])
  @@index([createdAt])

  @@map("supplier_debts")
}

// ==================== PEMBAYARAN UTANG ====================
model DebtPayment {
  id              String   @id @default(cuid())
  paymentNumber   String   @unique // PAY-001
  customerDebtId  String?
  supplierDebtId  String?
  paymentDate     DateTime @default(now())
  amount          Decimal  @db.Decimal(15, 2)
  paymentMethod   PaymentMethod
  notes           String?
  adminId         String 
  createdAt       DateTime @default(now())
  
  // Relations
  customerDebt CustomerDebt? @relation(fields: [customerDebtId], references: [id])
  supplierDebt SupplierDebt? @relation(fields: [supplierDebtId], references: [id])
  admin           User           @relation(fields: [adminId], references: [id])

  @@index([customerDebtId])
  @@index([supplierDebtId])
  @@index([paymentDate])
  @@index([createdAt])

  @@map("debt_payments")
}

enum DebtStatus {
  UNPAID
  PARTIAL
  PAID
  OVERDUE
}

// ==================== STOCK MOVEMENT ====================
model StockMovement {
  id            String   @id @default(cuid())
  productId     String
  type          MovementType
  quantity      Int
  referenceType String? // Sale, Purchase, Adjustment
  reference     String?
  referenceId   String?
  notes         String?
  createdById   String
  createdAt     DateTime @default(now())
  
  // Relations
  product Product @relation(fields: [productId], references: [id])
  createdBy User    @relation(fields: [createdById], references: [id])
  
  @@index([productId])
  @@index([createdAt])
  @@index([type, createdAt])
  @@index([referenceId])

  @@map("stock_movements")
}

enum MovementType {
  IN
  OUT
  ADJUSTMENT
  RETURN
}

// ==================== CASH MANAGEMENT ====================
model CashMovement {
  id          String   @id @default(cuid())
  type        CashType
  amount      Decimal  @db.Decimal(15, 2)
  description String
  category    String?
  userId      String
  createdAt   DateTime @default(now())
  
  // Relations
  user User @relation(fields: [userId], references: [id])
  
  @@index([createdAt])

  @@map("cash_movements")
}

enum CashType {
  IN
  OUT
}

// ==================== DELIVERY ORDER / SURAT JALAN ====================
model DeliveryOrder {
  id              String          @id @default(cuid())
  doNumber        String          @unique // DO-20240101-001
  customerId      String
  saleId          String?         @unique // Optional: link ke sale jika dari POS
  deliveryDate    DateTime
  driver          String?
  vehicle         String?
  notes           String?
  status          DeliveryStatus  @default(PENDING)
  receivedBy      String?
  receivedDate    DateTime?
  proofImage      String?         // URL Foto Bukti Pengiriman (R2/Cloudflare)
  createdById     String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  
  // Relations
  customer        Customer        @relation(fields: [customerId], references: [id])
  sale            Sale?           @relation(fields: [saleId], references: [id])
  createdBy       User            @relation(fields: [createdById], references: [id])
  deliveryItems   DeliveryItem[]
  deliveryPhotos  DeliveryPhoto[]
  
  @@index([customerId])
  @@index([createdAt])
  @@index([status])

  @@map("delivery_orders")
}

model DeliveryPhoto {
  id              String        @id @default(cuid())
  deliveryOrderId String
  url             String        // URL Cloudflare R2
  filename        String        // Key path di R2 (contoh: proofs_delivery/xxx.jpg)
  sizeBytes       Int           @default(0) // Ukuran file dalam bytes
  mimeType        String        @default("image/jpeg")
  uploadedById    String?
  createdAt       DateTime      @default(now())

  // Relations
  deliveryOrder   DeliveryOrder @relation(fields: [deliveryOrderId], references: [id], onDelete: Cascade)
  uploadedBy      User?         @relation(fields: [uploadedById], references: [id])

  @@index([deliveryOrderId])
  @@map("delivery_photos")
}

// ==================== PELACAKAN FILE R2 (22 Nov 2026) ====================
// Satu baris untuk SETIAP objek di Cloudflare R2. Sebelumnya upload lewat
// POST /api/upload langsung membuat objek R2 tanpa jejak DB apa pun —
// file yatim (batal simpan, ganti tanpa hapus, hapus data tanpa hapus
// file) tidak terdeteksi dan statistik kuota hanya tebakan (jumlah x 45KB).
// Alur: upload -> baris PENDING -> dikonfirmasi ACTIVE saat entitas
// pemilik disimpan (confirmR2File). Baris PENDING > 24 jam = kandidat
// yatim. Status DELETED dipertahankan sebagai jejak audit.
enum R2FileStatus {
  PENDING
  ACTIVE
  ORPHANED
  DELETED
  DELETE_FAILED
}

enum R2FileOwnerType {
  PRODUCT
  DELIVERY_PROOF
  PAYMENT_PROOF
  HERO
  LOGO
  UNKNOWN
}

model R2File {
  id           String         @id @default(cuid())
  r2Key        String         @unique // Key di R2, contoh: proofs_delivery/123.jpg
  url          String         // URL penuh yang dikembalikan Worker
  sizeBytes    Int            @default(0)
  mimeType     String         @default("image/jpeg")
  folder       String         // Folder R2: products / proofs_delivery / proofs_payment / heroes / logos
  ownerType    R2FileOwnerType @default(UNKNOWN)
  ownerId      String?        // ID entitas pemilik (productId / doId / saleId / heroId / storeSettingId)
  uploadedById String?
  status       R2FileStatus   @default(PENDING)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  uploadedBy User? @relation(fields: [uploadedById], references: [id])

  @@index([status])
  @@index([folder])
  @@index([ownerType, ownerId])
  @@map("r2_files")
}

model DeliveryItem {
  id                String         @id @default(cuid())
  deliveryOrderId   String
  productId         String
  unitId            String
  quantity          Decimal        @db.Decimal(10, 2)
  notes             String?
  createdAt         DateTime       @default(now())
  
  // Relations
  deliveryOrder DeliveryOrder @relation(fields: [deliveryOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id])
  unit          Unit          @relation(fields: [unitId], references: [id])
  
  @@index([deliveryOrderId])

  @@map("delivery_items")
}

enum DeliveryStatus {
  PENDING
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

// ==================== WHATSAPP ORDERS ====================
model WaOrder {
  id              String        @id @default(cuid())
  rawMessage      String        @db.Text       // Pesan asli dari WA
  senderPhone     String                        // No HP pengirim
  senderName      String                        // Nama pengirim di WA
  groupName       String?                       // Nama grup WA
  parsedItems     Json?                         // Hasil parse: [{productName, qty, unit}]
  customerName    String?                       // Nama customer yang dideteksi
  notes           String?       @db.Text
  status          WaOrderStatus @default(PENDING)
  rejectedReason  String?

  // Link ke sistem setelah dikonfirmasi
  deliveryOrderId String?
  saleId          String?

  receivedAt      DateTime      @default(now())
  confirmedAt     DateTime?
  confirmedById   String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  confirmedBy     User?         @relation(fields: [confirmedById], references: [id])

  @@index([status])
  @@index([receivedAt])
  @@map("wa_orders")
}

enum WaOrderStatus {
  PENDING
  CONFIRMED
  REJECTED
  PARTIAL // Dikonfirmasi sebagian
}

// ==================== SETTINGS MODULE ====================
model StoreSetting {
  id          String   @id @default(cuid())
  name        String   @default("TB Masdar Utama")
  tagline     String?
  logoUrl     String?
  phone       String?
  email       String?
  address     String?  @db.Text
  city        String?
  province    String?
  postalCode  String?
  website     String?
  instagram   String?
  facebook    String?
  whatsapp    String?
  taxNumber   String?  // NPWP
  bankName    String?
  bankAccount String?
  bankHolder  String?

  // PKG-A (23 Nov 2026, perbaikan 7 item #6): pengaturan poin loyalitas.
  // SUPER_ADMIN yang mengatur bebas dari tab Sales di Pengaturan.
  pointsEnabled       Boolean @default(true)
  pointsRupiahPerPoint Int    @default(10000)

  // PKG-H (23 Nov 2026, email pengingat utang): saklar email ringkasan,
  // jadwal pengingat (hari lewat jatuh tempo, dipisah koma, default 3,7,30)
  // dan jendela "akan jatuh tempo" (hari sebelum jatuh tempo).
  debtEmailEnabled   Boolean @default(true)
  debtReminderDays   String  @default("3,7,30")
  debtEmailDaysBefore Int    @default(3)
  
  // Invoice Global Settings
  invoiceLayoutType       String   @default("STRUK_KECIL") // STRUK_KECIL, INVOICE_BESAR, SURAT_JALAN, FAKTUR_NCR
  invoicePaperSize        String   @default("58mm")
  invoiceDocumentPaperSize String? @default("A4")
  invoiceShowHeader       Boolean  @default(true)
  invoiceShowLogo         Boolean  @default(true)
  invoiceShowCustomerInfo Boolean  @default(true)
  invoiceShowPaymentInfo  Boolean  @default(true)
  invoiceShowSignature    Boolean  @default(true)
  invoiceShowFooter       Boolean  @default(true)
  invoiceFooterTerms      String?  @default("BARANG YANG SUDAH DIBELI TIDAK DAPAT DITUKAR/DIKEMBALIKAN KECUALI ADA PERJANJIAN.")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@map("store_settings")
}

// PKG-H (23 Nov 2026, email pengingat utang): daftar email penerima
// ringkasan utang jatuh tempo — dikelola SUPER_ADMIN dari tab
// "Notifikasi Utang" di Pengaturan. Satu baris per alamat supaya bisa
// diaktifkan/dinonaktifkan dan dicatat siapa yang menambahkan.
model DebtNotificationRecipient {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  isActive  Boolean  @default(true)
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("debt_notification_recipients")
}

// PKG-H: jejak pengiriman email ringkasan utang — dipakai dedup harian
// (cron terpanggil 2x dalam sehari tidak boleh mengirim 2x) dan untuk
// info "terakhir terkirim" di tab Notifikasi Utang.
model DebtEmailLog {
  id              String   @id @default(cuid())
  sentAt          DateTime @default(now())
  customerOverdue Int      @default(0)
  customerDueSoon Int      @default(0)
  supplierOverdue Int      @default(0)
  supplierDueSoon Int      @default(0)
  recipientCount  Int      @default(0)
  totalCustomer   Decimal  @db.Decimal(15, 2) @default(0)
  totalSupplier   Decimal  @db.Decimal(15, 2) @default(0)

  @@index([sentAt])

  @@map("debt_email_logs")
}

model LandingPageSetting {
  id                  String   @id @default(cuid())
  heroTitle           String   @default("TB Masdar Utama")
  heroSubtitle        String   @default("Distributor Bahan Bangunan Terpercaya")
  aboutUs             String?  @db.Text
  whyChooseUs         String?  @db.Text
  showFeaturedProducts Boolean @default(true)
  contactMapUrl       String?  // Google Maps embed URL
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  
  heroImages          HeroImage[]
  
  @@map("landing_page_settings")
}

model HeroImage {
  id          String              @id @default(cuid())
  landingId   String
  imageUrl    String
  order       Int                 @default(0)
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  
  landing     LandingPageSetting  @relation(fields: [landingId], references: [id], onDelete: Cascade)
  
  @@index([landingId])
  @@map("hero_images")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@map("password_reset_tokens")
}

// PKG-I (23 Nov 2026, OTP verifikasi email akun baru): kode OTP 6 digit
// disimpan sebagai hash SHA-256 (bukan mentah — meniru pola
// PasswordResetToken), berlaku 15 menit, maks 5 percobaan salah.
// Satu user hanya punya satu token aktif — OTP baru menggugurkan yang lama.
model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  otpHash   String   @unique
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

// ==================== RATE LIMIT (DB-BACKED) ===================
// SECURITY FIX (22 Nov 2026, pentest M28): hitungan rate limit pindah
// dari Map in-memory per instance (tidak berlaku antar-instance serverless
// Vercel) ke tabel ini, supaya batas percobaan login / ganti password /
// reset password benar-benar mengikat. Satu baris per kunci
// (mis. "login:1.2.3.4:user@mail.com"), count direset tiap jendela baru.
// Baris kedaluwarsa (>24 jam) disapu oportunistik saat mencatat hit baru.
model RateLimit {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([windowStart])

  @@map("rate_limits")
}

// ==================== PAGE ACCESS MATRIX ====================
model PageAccess {
  id        String   @id @default(cuid())
  pageKey   String   // "pos", "reports_settings", "po", "invoice_layout", "stock_opname"
  role      Role     // SUPER_ADMIN, ADMIN, KASIR
  enabled   Boolean  @default(false)
  updatedBy String?
  updatedAt DateTime @updatedAt @default(now())

  @@unique([pageKey, role])
  @@map("page_access")
}


// ==================== DEVICE TOKENS (MULTI-DEVICE PUSH) ====================
model DeviceToken {
  id         String   @id @default(cuid())
  userId     String
  token      String   @unique
  platform   String   @default("android") // android, ios, web
  deviceName String?
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

// ==================== NOTIFICATIONS (PERSISTENT IN-APP HISTORY) ====================
model Notification {
  id        String           @id @default(cuid())
  userId    String?          // null = broadcast ke role
  role      Role?            // SUPER_ADMIN, ADMIN, KASIR
  title     String
  body      String           @db.Text
  type      NotificationType
  screen    String?          // e.g. "POS", "Delivery", "Debt", "Purchase"
  params    Json?            // e.g. { saleId: "xxx", doId: "yyy" }
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([role, isRead])
  @@index([type, createdAt])

  @@map("notifications")
}

enum NotificationType {
  NEW_ORDER
  ORDER_STATUS
  PAYMENT_RECEIVED
  DELIVERY_UPDATE
  DEBT_DUE
  LOW_STOCK
  SYSTEM_ALERT
}

// ==================== FLEET / ARMADA TRACKING ====================
model FleetVehicle {
  id             String    @id @default(cuid())
  plateNumber    String    @unique // Contoh: DD 8234 XY
  vehicleType    String    @default("PICKUP") // TRUCK, PICKUP, MOTOR, VAN, OTHER
  brand          String?   // Mitsubishi, Isuzu, Toyota, Suzuki, Honda
  year           Int?
  driverName     String    // Nama sopir
  driverPhone    String?   // No telepon sopir
  // FIX (22 Nov 2026, rombakan armada): kaitan ke akun User sopir utama dan
  // sopir pendamping (boleh role apa pun — ADMIN pun bisa jadi sopir).
  // Dipakai aturan GPS: ADMIN+ untuk kendaraan apa pun, atau sopir yang
  // ditugaskan untuk kendaraannya sendiri. Hapus akun -> SET NULL.
  driverUserId   String?
  coDriverUserId String?
  driverUser     User?     @relation("VehicleDriver", fields: [driverUserId], references: [id], onDelete: SetNull)
  coDriverUser   User?     @relation("VehicleCoDriver", fields: [coDriverUserId], references: [id], onDelete: SetNull)
  status         String    @default("ACTIVE") // ACTIVE, IDLE, MAINTENANCE, OFF
  latitude       Float?
  longitude      Float?
  address        String?
  lastLocationAt DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([driverUserId])
  @@index([coDriverUserId])

  @@map("fleet_vehicles")
}

