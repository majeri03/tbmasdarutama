-          paymentMethod: "CREDIT",
-          status: "PENDING",
-          totalAmount: grandTotal,
-          tax: 0,
-          discount: 0,
-          grandTotal,
-          paidAmount: 0,
-          changeAmount: 0,
-          notes: `Dari orderan WA - ${waOrder.senderName} (${waOrder.senderPhone})`,
-          saleItems: { create: saleItemsData },
-        },
-      });
-
-      // Potong stok & catat StockMovement untuk setiap item
